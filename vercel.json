{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "env": {
    "VITE_APP_NAME": "Fake WhatsApp Chat Generator",
    "VITE_APP_VERSION": "1.0.0",
    "VITE_BUILD_TIME": "@now"
  },
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health.json"
    }
  ],
  "headers": [
    {
      "source": "/api/health.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=60"
        }
      ]
    }
  ]
}